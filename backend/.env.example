# =============================================================================
# HALL BOOKING / VENUE MANAGEMENT SYSTEM – ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port & Secret Key
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hall_booking

# Email Service Configuration (SMTP / Gmail / SendGrid)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email_user@college.edu
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="Venue Portal" <no-reply@college.edu>

# WhatsApp Business Cloud API Configuration (Meta Graph API)
# Official Cloud API Provider
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token
