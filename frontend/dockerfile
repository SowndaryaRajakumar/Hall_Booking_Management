# =========================
# Stage 1: Build React App
# =========================
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# Docker-only fix:
# Windows project has Halldetails.jsx, while App.jsx imports HallDetails.
# This changes ONLY the copy inside the Docker image.
RUN sed -i 's#\./pages/HallDetail/HallDetails#./pages/HallDetail/Halldetails#g' src/App.jsx

RUN npm run build


# =========================
# Stage 2: Nginx
# =========================
FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*

COPY --from=build /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]